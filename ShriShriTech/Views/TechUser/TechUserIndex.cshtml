@model ShriShriTech.Data.user
@{
    ViewData["Title"] = "Register";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<h2 class="app-title text-center">Registration</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="app-card">
    @using (Html.BeginForm("TechUserIndex", "TechUser", FormMethod.Post, new { @class = "app-form" }))
    {
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <div class="row g-3">
            <div class="col-12 col-md-6">
                @Html.LabelFor(m => m.FirstName, new { @class = "form-label" })
                @Html.TextBoxFor(m => m.FirstName, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.FirstName, "", new { @class = "text-danger" })
            </div>
            <div class="col-12 col-md-6">
                @Html.LabelFor(m => m.LastName, new { @class = "form-label" })
                @Html.TextBoxFor(m => m.LastName, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.LastName, "", new { @class = "text-danger" })
            </div>
            <div class="col-12 col-md-6">
                @Html.LabelFor(m => m.Email, new { @class = "form-label" })
                @Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email" })
                @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
            </div>
            <div class="col-12 col-md-6">
                @Html.LabelFor(m => m.ContactNo, new { @class = "form-label" })
                @Html.TextBoxFor(m => m.ContactNo, new { @class = "form-control", maxlength = 10, inputmode = "numeric", type = "tel" })
                @Html.ValidationMessageFor(m => m.ContactNo, "", new { @class = "text-danger" })
            </div>
            <div class="col-12 col-md-6">
                @Html.LabelFor(m => m.StoreName, new { @class = "form-label" })
                @Html.TextBoxFor(m => m.StoreName, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.StoreName, "", new { @class = "text-danger" })
            </div>
            <div class="col-12 col-md-6">
                @Html.LabelFor(m => m.Designation, new { @class = "form-label" })
                @Html.DropDownListFor(m => m.Designation,
                new SelectList(new[]{"STAFF","BRAND","OWNER"}),
                new {@class = "form-select"})
                @Html.ValidationMessageFor(m => m.Designation, "", new { @class = "text-danger" })
            </div>
            <div class="col-12">
                @Html.LabelFor(m => m.Store_Address, new { @class = "form-label" })
                @Html.TextAreaFor(m => m.Store_Address, 2, 0, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.Store_Address, "", new { @class = "text-danger" })
            </div>
            <div class="col-12 col-md-6">
                @Html.LabelFor(m => m.City, new { @class = "form-label" })
                @Html.TextBoxFor(m => m.City, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.City, "", new { @class = "text-danger" })
            </div>
            <div class="col-12 col-md-6">
                @Html.LabelFor(m => m.Pincode, new { @class = "form-label" })
                @Html.TextBoxFor(m => m.Pincode, new { @class = "form-control", maxlength = 6, inputmode = "numeric" })
                @Html.ValidationMessageFor(m => m.Pincode, "", new { @class = "text-danger" })
            </div>
            <div class="col-12 col-md-6">
                @Html.LabelFor(m => m.District, new { @class = "form-label" })
                @Html.TextBoxFor(m => m.District, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.District, "", new { @class = "text-danger" })
            </div>
            <div class="col-12 col-md-6">
                @Html.LabelFor(m => m.State, new { @class = "form-label" })
                @Html.TextBoxFor(m => m.State, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.State, "", new { @class = "text-danger" })
            </div>
            <div class="col-12 col-md-6">
                @Html.LabelFor(m => m.Pass, new { @class = "form-label" })
            <div class="input-group">
                @Html.PasswordFor(m => m.Pass, new { @class = "form-control", placeholder = "Enter your password", autocomplete = "new-password" })
                <button type="button" class="btn btn-outline-secondary toggle-password" tabindex="-1" aria-label="Show password">
                    <i class="bi bi-eye"></i>
                </button>
            </div>
                @Html.ValidationMessageFor(m => m.Pass, "", new { @class = "text-danger" })
            </div>
            <div class="col-12 col-md-6">
                @Html.LabelFor(m => m.ConfirmPass, new { @class = "form-label" })
                <div class="input-group">
                    @Html.PasswordFor(m => m.ConfirmPass, new { @class = "form-control", placeholder = "Confirm your password", autocomplete = "new-password" })
                    <button type="button" class="btn btn-outline-secondary toggle-password" tabindex="-1" aria-label="Show password">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>

                @Html.ValidationMessageFor(m => m.ConfirmPass, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="app-actions mt-4">
            <button type="submit" class="btn btn-primary">Register</button>
            @Html.ActionLink("Cancel", "Index", "Home", null, new { @class = "btn btn-secondary" })
        </div>
        <p class ="text-center mt-3 mb-0">
            Already have an account?
            <a asp-controller="TechUser" asp-action="checkAuth">Login Here</a>
        </p>
    }
    
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('click', function (e) {
            var btn = e.target.closest('.toggle-password');
            if (!btn) return;

            var input = btn.parentElement.querySelector('input');
            var icon = btn.querySelector('i');
            var show = input.type === 'password';

            input.type = show ? 'text' : 'password';
            icon.classList.toggle('bi-eye', !show);
            icon.classList.toggle('bi-eye-slash', show);
        });
    </script>
}